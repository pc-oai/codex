#!/usr/bin/env python3
"""Build and archive local Codex with an automatically bumped footer label."""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
CODEX_RS = REPO_ROOT / "codex-rs"
VERSION_RS = CODEX_RS / "tui" / "src" / "version.rs"
DEFAULT_TARGET_DIR = CODEX_RS / "target"
LOCAL_BUILDS_DIR = DEFAULT_TARGET_DIR / "local-builds"
BUILD_NUMBER_RE = re.compile(r"(pub const LOCAL_BUILD_NUMBER: u32 = )(\d+)(;)")


def build_target_dir() -> Path:
    target_dir = os.environ.get("CARGO_TARGET_DIR")
    if target_dir is None:
        return DEFAULT_TARGET_DIR

    target_dir_path = Path(target_dir)
    if target_dir_path.is_absolute():
        return target_dir_path
    return CODEX_RS / target_dir_path


def bumped_version_source(source: str) -> tuple[str, int]:
    match = BUILD_NUMBER_RE.search(source)
    if match is None:
        raise SystemExit(f"Could not find LOCAL_BUILD_NUMBER in {VERSION_RS}")

    next_build_number = int(match.group(2)) + 1
    updated_source = BUILD_NUMBER_RE.sub(
        rf"\g<1>{next_build_number}\g<3>",
        source,
        count=1,
    )
    return updated_source, next_build_number


def executable_name(name: str) -> str:
    return f"{name}.exe" if sys.platform == "win32" else name


def built_codex_binary() -> Path:
    return build_target_dir() / "debug" / executable_name("codex")


def archived_codex_binary(build_number: int) -> Path:
    return LOCAL_BUILDS_DIR / f"v{build_number}" / executable_name("codex")


def archive_local_build(build_number: int) -> Path:
    built_binary = built_codex_binary()
    if not built_binary.exists():
        raise SystemExit(f"Built Codex binary not found at {built_binary}")

    archived_binary = archived_codex_binary(build_number)
    if archived_binary.exists():
        raise SystemExit(
            f"Refusing to replace archived local Codex v{build_number} at {archived_binary}"
        )

    archived_binary.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(built_binary, archived_binary)
    return archived_binary


def main() -> int:
    original_source = VERSION_RS.read_text()
    updated_source, next_build_number = bumped_version_source(original_source)
    VERSION_RS.write_text(updated_source)

    try:
        completed = subprocess.run(
            ["cargo", "build", "-p", "codex-cli", *sys.argv[1:]],
            cwd=CODEX_RS,
            check=False,
        )
    except BaseException:
        VERSION_RS.write_text(original_source)
        raise

    if completed.returncode != 0:
        VERSION_RS.write_text(original_source)
        return completed.returncode

    try:
        archived_binary = archive_local_build(next_build_number)
    except BaseException:
        VERSION_RS.write_text(original_source)
        raise

    print(f"Built local Codex v{next_build_number}")
    print(f"Saved local Codex v{next_build_number} at {archived_binary}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
