#!/usr/bin/env python3
"""Build the local Codex binary with an automatically bumped footer label."""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
CODEX_RS = REPO_ROOT / "codex-rs"
VERSION_RS = CODEX_RS / "tui" / "src" / "version.rs"
BUILD_NUMBER_RE = re.compile(r"(pub const LOCAL_BUILD_NUMBER: u32 = )(\d+)(;)")


def bumped_version_source(source: str) -> tuple[str, int]:
    match = BUILD_NUMBER_RE.search(source)
    if match is None:
        raise SystemExit(f"Could not find LOCAL_BUILD_NUMBER in {VERSION_RS}")

    next_build_number = int(match.group(2)) + 1
    updated_source = BUILD_NUMBER_RE.sub(
        rf"\g<1>{next_build_number}\g<3>",
        source,
        count=1,
    )
    return updated_source, next_build_number


def main() -> int:
    original_source = VERSION_RS.read_text()
    updated_source, next_build_number = bumped_version_source(original_source)
    VERSION_RS.write_text(updated_source)

    try:
        completed = subprocess.run(
            ["cargo", "build", "-p", "codex-cli", *sys.argv[1:]],
            cwd=CODEX_RS,
            check=False,
        )
    except BaseException:
        VERSION_RS.write_text(original_source)
        raise

    if completed.returncode != 0:
        VERSION_RS.write_text(original_source)
        return completed.returncode

    print(f"Built local Codex v{next_build_number}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
